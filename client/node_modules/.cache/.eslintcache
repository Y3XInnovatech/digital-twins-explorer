es and state (https://reactjs.org/docs/reconciliation.html#elements-of-different-types). Instead, move this component definition out of the parent component “GraphViewerCommandBarComponent” and pass data as props. If you want to allow component creation in props, set allowAsProps option to true.","ArrowFunctionExpression",{"range":"532","text":"533"},"Unused method or property \"open\" of class \"GraphViewerRelationshipViewerComponent\"","Unused method or property \"open\" of class \"GraphViewerTwinDeleteComponent\"",{"range":"534","text":"501"},"Unused method or property \"resetModalState\" of class \"KeyboardShortcutsComponents\"","Unused method or property \"open\" of class \"KeyboardShortcutsComponents\"","Unused method or property \"open\" of class \"DeleteAllTwinsComponent\"","Unused method or property \"getStyles\" of class \"PreferencesFormComponent\"",{"range":"535","text":"536"},{"range":"537","text":"538"},{"range":"539","text":"540"},{"range":"541","text":"542"},"Unused method or property \"buttonClass\" of class \"ModelViewerItemCommandBarComponent\"","Unused method or property \"clickOverflowButton\" of class \"ModelViewerItemCommandBarComponent\"","Unused method or property \"open\" of class \"ModelViewerDeleteAllModelsComponent\"",[4824,4856],"isLoading ? <LoaderComponent /> : null",[5782,5814],[5601,5633],[34058,34107],"highlightingTerms ? highlightingTerms.length > 0 : null",[34450,37108],"couldNotDisplay ? <div\n                className={`alert-no-display ${outputIsOpen ? \"output\" : \"\"} ${\n                  noResults ? \"no-results\" : \"\"\n                }`}>\n                <div className=\"alert--info\">i</div>\n                <div className=\"alert--message\">\n                  {noResults ? (\n                    <span>No results found. </span>\n                  ) : (\n                    <>\n                      {relationshipsOnly ? (\n                        <>\n                          <span>\n                            A graph may only be rendered if the results contain\n                            a twin.{\" \"}\n                          </span>\n                          <span>Click here to open the </span>\n                          <a\n                            onClick={() => {\n                              eventService.publishOpenTabularView(\n                                this.relationships\n                              );\n                              this.setState({ couldNotDisplay: false });\n                            }}>\n                            Tabular Relationships View\n                          </a>\n                        </>\n                      ) : (\n                        <span>\n                          The query returned results that could not be displayed\n                          or overlayed.{\" \"}\n                        </span>\n                      )}\n                      {!outputIsOpen && (\n                        <>\n                          <span> or open the </span>\n                          <a\n                            onClick={() => {\n                              eventService.publishOpenOptionalComponent(\n                                \"output\"\n                              );\n                              this.setState({ couldNotDisplay: false });\n                            }}>\n                            Output Panel\n                          </a>\n                          <span>\n                            {\" \"}\n                            and run the query again to see the results.\n                          </span>\n                        </>\n                      )}\n                    </>\n                  )}\n                </div>\n                <Icon\n                  className=\"alert--close\"\n                  iconName=\"ChromeClose\"\n                  aria-label={this.props.t(\n                    \"graphViewerComponent.alertCloseIcon\"\n                  )}\n                  role=\"button\"\n                  onClick={() => this.setState({ couldNotDisplay: false })}\n                  title=\"Close alert\" />\n              </div> : null",[38809,38970],"isLoading ? <LoaderComponent\n              message={`${Math.round(progress)}%`}\n              cancel={() => (this.canceled = true)} /> : null",[39818,39934],"propertyInspectorIsOpen ? <div className=\"dragable\" onMouseDown={this.handleMouseDown} /> : null",[1485,1494],"() ",[2214,2246],[2767,2861],"error ? <div className=\"iv-control\">\n          <p>Unrecognized file format</p>\n        </div> : null",[3137,3169],[593,643],"message ? <div className=\"status\">{message}</div> : null",[689,735],"cancel ? <Link onClick={cancel}>Cancel</Link> : null",[4793,4916],"showAdtChinaWarningMessage ? <MessageBar>\n            {this.props.t(\"errorMessages.chinaSupport\")}\n          </MessageBar> : null",[5169,5346],"stackErrorMessage ? <div className=\"error-description\">\n              <p dangerouslySetInnerHTML={{ __html: stackErrorMessage }} />\n            </div> : null",[1661,1843],"model ? <pre tabIndex=\"0\" id=\"code-container\">\n              <code className=\"language-js\">\n                {JSON.stringify(model, null, 1)}\n              </code>\n            </pre> : null",[2419,3073],"isSelected ? relationships.map(rel => (\n        <div className=\"tv-relationships\" key={rel.$relationshipId}>\n          <Stack horizontal={false}>\n            <div className=\"tv_listItem\" tabIndex=\"0\" onClick={() => onSelectRelationship(rel)} onKeyDown={e => handleRelationshipKeyDown(e, rel)} >\n              <Stack horizontal={false}>\n                <div className=\"tv_listItemName\" data-selection-invoke>{rel.$relationshipName}</div>\n                <div className=\"tv_listItemKey\" data-selection-invoke>{item.$dtId === rel.$sourceId ? rel.$targetId : rel.$sourceId}</div>\n              </Stack>\n            </div>\n          </Stack>\n        </div>)) : null",[5571,6308],"hasRelationships ? <div>\n            <Dropdown\n              tabIndex=\"0\"\n              ariaLabel={this.props.t(\"graphViewerRelationshipCreateComponent.optionSelection\")}\n              required\n              placeholder={this.props.t(\"graphViewerRelationshipCreateComponent.optionSelection\")}\n              className=\"modal-input\"\n              selectedKey={relationshipId}\n              options={relationshipItems.map((q, i) => ({ key: i, text: q }))}\n              styles={{\n                dropdown: { width: 208 }\n              }}\n              errorMessage={hasRequiredRelError ? this.props.t(\"graphViewerRelationshipCreateComponent.selectRelationship\") : null}\n              onChange={this.onSelectedRelChange} />\n          </div> : null",[7648,7888],"optionProps.data ? <span\n              title={this.props.t(\"graphViewerCommandBarComponent.displayName.occurrenceTitle\")}\n              className=\"display-name-occurrence-count\">\n              ({optionProps.data.count})\n            </span> : null",[468,500],[5077,5388],"this.state.isEnvironmentSelected ? <DefaultButton\n                  className=\"modal-button cancel-button\"\n                  onClick={this.closeConfigurationSettings}>\n                  {this.props.t(\"configurationFormComponent.cancelButton\")}\n                </DefaultButton> : null",[723,758],"description ? <p>{description}</p> : null",[4963,5436],"term.menuIsOpen ? <div className=\"term-menu\">\n                        {this.menuItems.map(item => (\n                          <div className=\"term-menu-item\" key={item.key} aria-label={item.ariaLabel}>\n                            <Checkbox checked={term[item.key] === true} onChange={() => this.toggleCheckbox(term, item.key)} />\n                            <span>{item.text}</span>\n                          </div>\n                        ))}\n                      </div> : null",[6427,6529],"actionText ? <button className=\"action-button\" type=\"button\" onClick={onAction}>{actionText}</button> : null"]